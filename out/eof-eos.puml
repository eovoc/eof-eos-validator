"AdditionalAttributes" "0..1" -->  "DataIdentification" : DataIdentification
"Point" "0..1" -->  "GeometryOptionA" : Point
"MultiPoint" "0..1" -->  "GeometryOptionB" : MultiPoint
"LineString" "0..1" -->  "GeometryOptionC" : LineString
"MultiLineString" "0..1" -->  "GeometryOptionD" : MultiLineString
"Polygon" "0..1" -->  "GeometryOptionE" : Polygon
"MultiPolygon" "0..1" -->  "GeometryOptionF" : MultiPolygon
"Geometry" "0..1" -->  "EarthObservationOptionA" : Geometry
"Link" "0..1" -->  "Links" : Link
"Link" "0..1" -->  "Links" : Link
"Link" "0..1" -->  "Links" : Link
"Link" "0..1" -->  "Links" : Link
"Links" "0..1" -->  "Properties" : Links
"AcquisitionInformation" "0..1" -->  "Properties" : AcquisitionInformation
"ProductInformation" "0..1" -->  "Properties" : ProductInformation
"Properties" "0..1" -->  "EarthObservation" : Properties
"GeometryOption"  -->  "EarthObservation" : EarthObservation
"EarthObservation" "0..1" -->  "FeatureCollection" : EarthObservation
"Platform" "0..1" -->  "AcquisitionInformation" : Platform
"Instrument" "0..1" -->  "AcquisitionInformation" : Instrument
"AcquisitionAngles" "0..1" -->  "AcquisitionParameters" : AcquisitionAngles
"WavelengthInformation" "0..1" -->  "AcquisitionParameters" : WavelengthInformation
"AcquisitionParameters" "0..1" -->  "AcquisitionInformation" : AcquisitionParameters
"Operation" "0..1" -->  "Offering" : Operation
"Request" "0..1" -->  "Operation" : Operation
"Result" "0..1" -->  "Operation" : Operation
@enduml
