  roll : Integer
  yaw : Integer
}

class "CoverageDescription" {
  cloudCover : Integer
  snowCover : Integer
}

class "FeatureCollection" {
  type : typeEnum_8
}

class "WavelengthInformation" {
  discreteWavelengths : Integer "1..*"
  startWavelength : Integer
  endWavelength : Integer
  wavelengthResolution : Integer
}

class "VerticalSpatialDomain" {
  highestLocation : String
  lowestLocation : String
