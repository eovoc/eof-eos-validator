}

class "AdditionalAttributes" {
}

class "ProcessingInformation" {
  processorName : String
  processorVersion : String
  processingCenter : String
  processingDate : Date
  compositeType : String
  format : String
  processingMethod : String
  processingMethodVersion : String
}

class "Point" {
  coordinates : Integer "2..2"
  type : typeEnum
}

class "MultiPoint" {
  type : typeEnum_2
}

class "LineString" {
  type : typeEnum_3
}

class "MultiLineString" {
  type : typeEnum_4
}

class "Polygon" {
  type : typeEnum_5
}

class "MultiPolygon" {
  type : typeEnum_6
}

class "Geometry" {
}

class "GeometryOptionA" {
}

class "GeometryOptionB" {
}

class "GeometryOptionC" {
}

class "GeometryOptionD" {
}

class "GeometryOptionE" {
}

class "GeometryOptionF" {
}

class "Links" {
}

class "Properties" {
}

class "EarthObservation" {
  type : typeEnum_7
  id : String
  bbox : Integer "4..4"
}

abstract class "GeometryOption" {
}

class "EarthObservationOptionA" {
}

class "EarthObservationOptionB" {
}

class "Platform" {
  platformSerialIdentifier : String
}

class "Instrument" {
