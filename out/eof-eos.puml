}

class "AcquisitionParameters" {
  acquisitionSubType : String
  startTimeFromAscendingNode : Integer
  completionTimeFromAscendingNode : Integer
  relativeOrbitNumber : Integer
  wrsLongitude : String
  wrsLatitude : String
  tileId : String
  groundTrackUncertainty : Integer
  cycleNumber : Integer
  operationalMode : String
  swathIdentifier : String
  resolution : Integer
  verticalResolution : Integer
  dopplerFrequency : Integer
  samplingRates : Integer "1..*"
}

class "Link" {
  href : String
  title : String
  length : Integer
}

class "ProductInformation" {
  productType : String
  size : Integer
  statusDetail : String
  referenceSystemIdentifier : String
}

class "AcquisitionAngles" {
  illuminationAzimuthAngle : Integer
  illuminationZenithAngle : Integer
  illuminationElevationAngle : Integer
