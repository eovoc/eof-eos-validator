@startuml
hide empty members
skinparam classAttributeIconSize 0

enum "typeEnum" {
  Point
}

enum "typeEnum_2" {
  MultiPoint
}

enum "typeEnum_3" {
  LineString
}

enum "typeEnum_4" {
  MultiLineString
}

enum "typeEnum_5" {
  Polygon
}

enum "typeEnum_6" {
  MultiPolygon
}

enum "typeEnum_7" {
  Feature
}

enum "typeEnum_8" {
  FeatureCollection
}

enum "locationUnitEnum" {
  bar
