}

class "TemporalInformation" {
  beginningDateTime : Date
  endingDateTime : Date
}

class "AcquisitionInformation" {
}

class "Offering" {
  code : String
}

class "OrbitParameters" {
  orbitDuration : Integer
  ascendingNodeDate : Date
  ascendingNodeLongitude : Integer
