        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">NGGM</skos:prefLabel>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/platforms"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/c55d6941-023c-514c-a9c4-1693c053f861"/>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-07-12</dct:modified>
        <rdfs:seeAlso rdf:resource="https://www.esa.int/Applications/Observing_the_Earth/FutureEO/Preparing_for_tomorrow/Citation_for_Next_Generation_Gravity_Mission_Mission_Requirements_Document"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">NGGM will extend and improve time series of satellite gravity missions by providing enhanced spatial and temporal resolution time-varying gravity field measurements with improved performance and and latency.</skos:definition>
    </rdf:Description>
