    <rdf:Description rdf:about="https://earth.esa.int/concept/d0a37de2-3ceb-5005-b734-d6d3fbb37287">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">PAZ</rdfs:label>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">PAZ</skos:prefLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/8ac70aba-53e7-45c0-8b4a-2c0197114b09"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/platforms"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/c55d6941-023c-514c-a9c4-1693c053f861"/>
        <owl:sameAs rdf:resource="http://yago-knowledge.org/resource/Paz_(satellite)"/>
        <owl:sameAs rdf:resource="http://dbpedia.org/resource/Paz_(satellite)"/>
        <owl:sameAs rdf:resource="http://www.wikidata.org/entity/Q9053779"/>
        <skos:notation xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">PZ1</skos:notation>
        <sosa:hosts rdf:resource="https://earth.esa.int/concept/6c3bde38-3fd7-574c-8db9-7655545afd8f"/>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-23</dct:modified>
        <rdfs:seeAlso rdf:resource="https://earth.esa.int/web/eoportal/satellite-missions/p/paz"/>
        <rdfs:seeAlso rdf:resource="https://directory.eoportal.org/web/eoportal/satellite-missions/p/paz"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">PAZ ("peace" in Spanish) is an X-band SAR (Synthetic Aperture Radar) spacecraft based on the TerraSAR-X platform, to serve the security and the defense needs of Spain. The PAZ mission is a dual-use mission (civil/defense) funded and owned by the Spanish Ministry of Defense and managed by Hisdesat (see also https://www.hisdesat.es/en/satelites_observ-paz/).</skos:definition>
    </rdf:Description>
