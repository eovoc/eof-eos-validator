    <rdf:Description rdf:about="https://earth.esa.int/concept/48a68d1f-63e0-563a-b94e-67fee77706bb">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Sentinel-3 constellation</rdfs:label>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Sentinel-3</skos:prefLabel>
        <skos:altLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">SENTINEL-3</skos:altLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/8a19f309-46ee-424b-be9f-e7e57e5b8ca0"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/platforms"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/c55d6941-023c-514c-a9c4-1693c053f861"/>
        <owl:sameAs rdf:resource="http://yago-knowledge.org/resource/Sentinel-3"/>
        <owl:sameAs rdf:resource="http://dbpedia.org/resource/Sentinel-3"/>
        <skos:notation xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">S3A, S3B, S3C, S3D</skos:notation>
        <skos:note xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">A,B,C,D</skos:note>
        <rdfs:seeAlso rdf:resource="https://earth.esa.int/web/guest/missions/esa-eo-missions/sentinel-3"/>
        <rdfs:seeAlso rdf:resource="https://directory.eoportal.org/web/eoportal/satellite-missions/c-missions/copernicus-sentinel-3"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">The Sentinel-3 (S3) mission of ESA and the EC is one of the elements of the GMES (Global Monitoring for Environment and Security) program, which responds to the requirements for operational and near-real-time monitoring of ocean, land and ice surfaces over a period of 20 years. The topography element of this mission will serve primarily the marine operational users but will also allow the monitoring of sea ice and land ice, as well as inland water surfaces, using novel observation techniques.The Sentinel-3 mission is designed as a constellation of two identical polar orbiting satellites, separated by 180Âº, for the provision of long-term operational marine and land monitoring services. The operational character of this mission implies a high level of availability of the data products and fast delivery time, which have been important design drivers for the mission.</skos:definition>
        <skos:narrower rdf:resource="https://earth.esa.int/concept/8e754a1c-0947-56b2-bba9-c800e2b8e43d"/>
        <skos:narrower rdf:resource="https://earth.esa.int/concept/276d427e-b285-5071-8e5d-bfbf9067eadb"/>
        <skos:narrower rdf:resource="https://earth.esa.int/concept/a658afe3-8cd8-521b-9587-df8a1f5737cf"/>
        <skos:narrower rdf:resource="https://earth.esa.int/concept/b1c55132-48bb-5d91-af42-e17ad3eec38d"/>
    </rdf:Description>
