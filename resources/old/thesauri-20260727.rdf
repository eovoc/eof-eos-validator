    <rdf:Description rdf:about="https://earth.esa.int/concept/700b6e99-a527-5819-b283-4656c8832ea0">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">AMR-C</skos:prefLabel>
        <skos:altLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Advanced Microwave Radiometer-Climate Quality</skos:altLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/7f7f0396-7ea0-4b88-886c-a5c441372d71"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/instruments"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/f1b37458-0496-5b85-a295-c4768340f255"/>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-11</dct:modified>
        <rdfs:seeAlso rdf:resource="https://www.eoportal.org/satellite-missions/copernicus-sentinel-6-michael-freilich"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">The AMR-C is an evolution of the AMR developed by NASA-JPL, for Jason-2 and Jason-3, which itself was based on the TOPEX Microwave Radiometer (TMR) and Jason Microwave Radiometer (JMR) on the TOPEX/Poseidon and Jason-1 missions respectively.</skos:definition>
        <sosa:isHostedBy rdf:resource="https://earth.esa.int/concept/2f8e271e-ccca-5a51-b185-28dafd6a81c4"/>
    </rdf:Description>
