    <rdf:Description rdf:about="https://earth.esa.int/concepts/concept_scheme/instruments">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <rdfs:label xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Instruments</rdfs:label>
        <dct:modified xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2024-06-18</dct:modified>
        <dct:title xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">ESA Thesaurus</dct:title>
        <dct:description xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">The current thesaurus contains the concepts related the following schemes: platforms, instruments and earth topics.</dct:description>
        <owl:versionInfo xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">1.11</owl:versionInfo>
        <dct:rights xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Copyright 2018-2024 European Space Agency.</dct:rights>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2021/04/20 - Update gcmd base URI from https://gcmdservices.gsfc.nasa.gov/ to https://gcmd.earthdata.nasa.gov/</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2024/06/18 - Added concepts WFI (CBERS 1,2), WFI (CBERS 3,4), MUXCAM, PANMUX,OLI-2, TIRS-2, WFI (Amazonia-1), ABI, WPM, HSI (EnMAP), ALTIUS. Added partial mappings to DBpedia, Yago and WikiData.</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2024/01/11 - Added concepts POSEIDON-4, AMR-C, CAMERA, S-SAR.</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2023/03/03- Add concepts RBV hosted by landsat 1,2,3</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2022/03/30- Add concepts ACGS, CAPI, SSTL S1-4, PNEO, LRR ERS, LRR CryoSat. Rename PlanetScope Imager to PlanetScope Camera.</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2022/03/17- Add for CEOS JAXA: instrument SHIROP hosted by SLATS, relation hostedBy between instrument CIRC and platform CALET</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2022/03/17- Add SAOCOM-SAR hosted by SAOCOM</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2021/06/28 - Add GOCE hosted instruments: LRR, MGM.</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2021/04/20 - Add concepts FMPL-2, HyperScout-2 hosted by FSSCat</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2021/04/20 - Add concept GEMS hosted by GEO-KOMPSAT-2B</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2021/04/20 - Add GRACE-FO hosted instruments: GRACE-FO MWI, GRACE-FO ACC, GRACE-FO LRI, GRACE-FO LRR, GRACE-FO SCA, GRACE-FO TriG</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2021/04/20 - Add concept CSG-SAR hosted by COSMO-SkyMed Second Generation</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2021/04/20 - Add concepts AVNIR, OCTS hosted by ADEOS-I</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2021/04/20 - Add concepts AMSR, GLI hosted by ADEOS-II</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2021/04/20 - Add concept CIRC hosted by ALOS-2</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2021/04/20 - Update concept prefLabel WV6 renamed to WV60, WV1 to WV110</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2021/02/10 - Correct URI of NOAA POES for instrument AVHRR</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2020/11/18 - Update broader concept for ACC</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2020/11/17 - Update instrument MOS uri hosted by IRS-P3 that has a collision with MOS platform uri, add instruments hosted by MOS to MOS-1 and MOS-1B, update TIROS-N URI (collision with URI of platform)</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2020/11/16 - correct SWARM ACC: add missing exactMatch relationship with GCMD, correct GOSAT-2 TANSO-CAI-2 instrument GCMD URI, rename preflabel poseidon-2 to POSEIDON-2, correct JASON-1 TRSR: add missing exactMatch relationship with GCMD</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2020/10/26 - add hosts relationship between AVHRR hosted by NOAA-6 to NOAA-10</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2020/10/22 - add hosts relationship between MSC hosted by FireBird</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2020/09/23 - entry base:f1c81c30-c6f0-5d62-ace1-9c26165ea030 renamed to base:2ebd3948-3f88-5944-8e3c-7e60099ec941 (RA-2) hosted by ENVISAT, remove the hosted association with ERS-1, ERS-2</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2020/09/23 - add ATMS, VIIRS, CrIS, OMPS-N hosted by the three platforms JPSS-2, JPSS-3, JPSS-4</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2020/09/23 - WAF-P, PAZ-SAR, TANSO-CAI-2, TANSO-FTS-2</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2020/09/23 - change preflabel from MWR to S3 MWR for Sentinel-3</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2020/09/23 - change preflabel SAR to C-SAR for Sentinel_1</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2020/04/23 - GOME-2 hosted on METOP-C (CEOS DLR)</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2020/03/03 - Updated for CEOS: new JAXA collectons: SGLI</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2019/12/23 - Updated for CEOS: DLR add DESIS instrument for ISS, add instruments needed for ECV, CCI.</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2019/11/15 - Remove duplicated instruments LI3 (LISS-3), LI4 (LISS-4), AWF (AwiFS)</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2019/11/15 - updated due to JCCB-CP-506. GOME, LRR (ENVISAT), LRR (SWARM), PRARE (ERS-1, ERS-2), SSTI (GOCE), GRACE instruments, ALOS-1 instruments updated or added. Resourcesat-2 merged with irs-r2.</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2019/05/13 - updated due to JCCB-CP-494</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2019/03/11 - add entries for JAXA: PALSAR-2, SSMIS, DPR, GMI, SAPHIR, MHS, ATMS, PR, VIRS</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2019/03/05 - update MSC : add hosts TET-1, BIROS, update gcmd UUID of ESA X-SAR that corresponds to GCMD SAR.</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2019/03/01 - add entries AMSR2, TMI, update entry AwiFS add host IRS-P6, entry AVHRR add hosts noaa-12, noaa14, noaa-17.</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2018/10/12 - GCMD mapping for Sentinel-5P TROPOMI instrument added.</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2018/10/10 - Sentinel-5P TROPOMI instrument added. GCMD mapping for Sentinel-3 SRAL added.</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2018/10/08 - rdfs:label added to concept_scheme. Skos:related used instead of sosa:hostedBy to make link visible in SKOSMOS.</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2018/10/04 - base:db043b91-e620-5000-8a97-57ddaad16be4 and lower level nodes removed from instrument types. Appears a typo in the Excel version of GCMD, no longer present today.</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2025/01/08 - Added MWIR instrument.</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2021/06/28 - Replace altLabel of concept "SWARM Star Tracker" by the new GCMD matching instrument</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2020/10/07 - add instrument "STR" hosted by "GOCE"</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2020/09/23 - add SpaceView-110 hosted by the WorldView-4â&#128;&#157;</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2019/11/15 - updated due to JCCB-CP-506. Spectrometers/Radiometers -&gt; Interferometers renamed into "interferometric Radiometers". MIPAS and MIRAS categories changed. SWARM STR and LRR updated. Two spectrometer categories properly separated.</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2019/03/04 - add entry GOME-2 associated to METOP-A and METOP-B, entry liss-3 add host IRS-1C &amp; IRS-1D (for DLR mapping)</skos:changeNote>
        <skos:hasTopConcept rdf:resource="https://earth.esa.int/concept/c98c8eae-7561-55de-bf01-2fb866693c14"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://earth.esa.int/concept/fbd658b1-faf5-5578-9a54-3395de802b32">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Magnetic/Motion Sensors</skos:prefLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/fe684c79-5d9f-406e-8f28-0dce3ad65acf"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/instruments"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/a3ee9435-d2cb-5f33-b9fe-1f2e97c80717"/>
        <skos:narrower rdf:resource="https://earth.esa.int/concept/1e5ce64a-89e2-58e1-9385-743b762f1f29"/>
        <skos:narrower rdf:resource="https://earth.esa.int/concept/60130ec3-6913-5d82-9fbf-5a3cb3208a6e"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://earth.esa.int/concept/2ad310f4-958b-5333-853b-c095beb7e283">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Low Earth Multi-Use Receiver</rdfs:label>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Spire</skos:prefLabel>
        <skos:altLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">LEMUR</skos:altLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/da278af5-097b-47e7-903d-4deac395c4de"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/platforms"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/c55d6941-023c-514c-a9c4-1693c053f861"/>
        <skos:notation xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">SI</skos:notation>
        <schema:event rdf:resource="https://earth.esa.int/event/launch/fb6bfe8c-3d7e-5558-81fb-4a57a3ae0469"/>
        <sosa:hosts rdf:resource="https://earth.esa.int/concept/1c3bd49f-bdc9-5c33-a273-2f0f7a5b3f88"/>
        <sosa:hosts rdf:resource="https://earth.esa.int/concept/e5735a20-bdb8-5cff-b385-c16c84c855f4"/>
        <sosa:hosts rdf:resource="https://earth.esa.int/concept/11f58510-1770-53a7-9b13-5a5564b4e9c2"/>
        <rdfs:seeAlso rdf:resource="https://earth.esa.int/web/guest/missions/3rd-party-missions/current-missions/spire"/>
        <rdfs:seeAlso rdf:resource="https://www.eoportal.org/satellite-missions/spire-global"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Spire is a constellation of 60+ nanosatellites.</skos:definition>
        <skos:hiddenLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Lemur</skos:hiddenLabel>
    </rdf:Description>
    <rdf:Description rdf:about="https://earth.esa.int/concept/12f0c6eb-19fc-5bcd-8902-c46941e8a23b">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">TROPOMI</skos:prefLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/74ee2866-0e9e-4c20-8003-0621af6552f3"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/instruments"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/66ab957a-0434-5953-8b33-be95150a9ecb"/>
        <rdfs:seeAlso rdf:resource="https://sentinels.copernicus.eu/web/sentinel/user-guides/sentinel-5p-tropomi"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">The TROPOMI instrument is a space-borne, nadir-viewing, imaging spectrometer covering wavelength bands between the ultraviolet and the shortwave infrared.

The instrument, the single payload of the Sentinel-5P spacecraft, uses passive remote sensing techniques to attain its objective by measuring, at the Top Of Atmosphere (TOA), the solar radiation reflected by and radiated from the earth.</skos:definition>
        <sosa:isHostedBy rdf:resource="https://earth.esa.int/concept/811133ca-c658-5bcf-b1de-3bee525ae3d8"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://earth.esa.int/concept/88c2f503-b113-59bd-9c12-7c9dad6cda0d">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Tectonics</skos:prefLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/1e17c8d3-81d0-473c-8f24-d2a4ea52b6b9"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/earth-topics"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/1589db19-32b2-5945-ad4b-6c3b13713176"/>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-30</dct:modified>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">A branch of geology dealing with the broad architecture of the outer part of the Earth, that is, the regional assembling of structural or deformation features, a study of their mutual relations, origin and historical evolution.</skos:definition>
        <skos:narrower rdf:resource="https://earth.esa.int/concept/132b86d0-95ab-5def-8099-ec3f17fb152e"/>
        <skos:narrower rdf:resource="https://earth.esa.int/concept/6d9e76e2-c057-5e23-9950-e3ed6cb78f6d"/>
        <skos:narrower rdf:resource="https://earth.esa.int/concept/2d0947c9-0fb6-5faa-a87e-80edc53b2e37"/>
        <skos:related rdf:resource="https://earth.esa.int/concept/8f86e1ce-97c3-534d-b370-2692352992fe"/>
        <skos:related rdf:resource="https://earth.esa.int/concept/9a043c1c-b79e-56ea-8d29-ce17037667ef"/>
