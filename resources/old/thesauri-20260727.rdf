        <sosa:isHostedBy rdf:resource="https://earth.esa.int/concept/b3979ff2-d27d-5f22-9e06-a18c5759d9a5"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://earth.esa.int/concept/d9a8ec2e-1269-5292-aae6-dd1db28fa371">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Sentinel-1B</rdfs:label>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Sentinel-1B</skos:prefLabel>
        <skos:altLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">SENTINEL-1B</skos:altLabel>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/platforms"/>
