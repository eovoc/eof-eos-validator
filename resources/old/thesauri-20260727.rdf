    <rdf:Description rdf:about="https://earth.esa.int/concepts/groups/earth-explorers">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">EE (Earth Explorers)</skos:prefLabel>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/platforms"/>
        <rdfs:seeAlso rdf:resource="https://earth.esa.int/eogateway/missions/earth-explorers"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">ESA's Earth Explorer missions are dedicated to addressing key scientific challenges identified by the EO community.</skos:definition>
        <skos:member rdf:resource="https://earth.esa.int/concept/01d0faf3-e82a-587a-86c2-2b8d8bd52185"/>
        <skos:member rdf:resource="https://earth.esa.int/concept/a25a98f2-c03a-51b7-be4a-afab0863186c"/>
        <skos:member rdf:resource="https://earth.esa.int/concept/fc478009-7c76-54af-ba48-64c36705faef"/>
        <skos:member rdf:resource="https://earth.esa.int/concept/0d74ba05-9f2d-5dec-8e99-f756f7b06c56"/>
        <skos:member rdf:resource="https://earth.esa.int/concept/1abfac39-23bf-561f-a765-76da42a79d44"/>
        <skos:member rdf:resource="https://earth.esa.int/concept/7eb92e2a-7b12-56a7-be1a-a71c97778559"/>
        <skos:member rdf:resource="https://earth.esa.int/concept/c146a188-953f-5492-ab15-2e83c545d5cb"/>
        <skos:member rdf:resource="https://earth.esa.int/concept/07603ff0-3940-5c7a-bf47-98c4974e637b"/>
        <skos:member rdf:resource="https://earth.esa.int/concept/2fba3b73-669d-56c3-8bbf-212f5eb749c7"/>
        <skos:member rdf:resource="https://earth.esa.int/concept/b687f88d-4407-5c43-8f6a-85a5ab84f0d4"/>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-24</dct:modified>
    </rdf:Description>
    <rdf:Description rdf:about="https://earth.esa.int/concepts/groups/scout-missions">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">SCOUT (Scout Missions)</skos:prefLabel>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/platforms"/>
        <rdfs:seeAlso rdf:resource="https://www.esa.int/Applications/Observing_the_Earth/FutureEO/Scouts_ESA_s_agile_research_missions"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Scout missions are a new component of ESA's Earth Observation FutureEO programme. This new family of small satellites delivers value-added science, either by miniaturising existing space technologies or by demonstrating new observing techniques. Importantly, the overarching aim is to achieve all of this quickly.</skos:definition>
        <skos:member rdf:resource="https://earth.esa.int/concept/9703e5fa-3a2d-50ae-9cd5-fb7edee444e1"/>
        <skos:member rdf:resource="https://earth.esa.int/concept/2e4f77de-a8eb-5164-a506-f48f7b866309"/>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-18</dct:modified>
    </rdf:Description>
    <rdf:Description rdf:about="https://earth.esa.int/concept/cd28b71d-2e94-53a1-9296-6337be04803b">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Sentinel-4</rdfs:label>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Sentinel-4</skos:prefLabel>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/platforms"/>
        <skos:notation xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">S4</skos:notation>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Sentinel-4 (S-4), a part of the Copernicus European Earth observation programme (previously known as the Global Monitoring for Environment and Security (GMES) programme), represents the geostationary component of European atmospheric composition monitoring missions.</skos:definition>
        <skos:broader rdf:resource="https://earth.esa.int/concept/c55d6941-023c-514c-a9c4-1693c053f861"/>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-22</dct:modified>
        <owl:sameAs rdf:resource="http://dbpedia.org/resource/Sentinel-4"/>
        <owl:sameAs rdf:resource="http://yago-knowledge.org/resource/Sentinel-4"/>
        <rdfs:seeAlso rdf:resource="https://www.eoportal.org/satellite-missions/copernicus-sentinel-4"/>
    </rdf:Description>
