    <rdf:Description rdf:about="https://earth.esa.int/concept/a5ddc423-fdec-5f65-acf4-51087b065cea">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">GEOSAT-1 mission</rdfs:label>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">GEOSAT-1</skos:prefLabel>
        <skos:altLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Deimos-1</skos:altLabel>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/platforms"/>
        <skos:notation xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">GSAT-1</skos:notation>
        <skos:note xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">1</skos:note>
        <schema:event rdf:resource="https://earth.esa.int/event/launch/6c510ea6-dbed-5ded-ac83-ac8ccfe58e5c"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">The GEOSAT-1 mission objectives are commercial with the optical satellite images aimed at services and applications in maritime, agriculture, environment and forestry within the Iberian Peninsula region and Europe.</skos:definition>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/8b35d386-0999-4b6e-ad12-f8501427b0ca"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/51080430-be96-5055-bdac-17b9ed04a9fd"/>
        <sosa:hosts rdf:resource="https://earth.esa.int/concept/5cc6eaab-0ddc-572f-a1b7-afa52ea5333d"/>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-24</dct:modified>
        <owl:sameAs rdf:resource="http://dbpedia.org/resource/Deimos-1"/>
        <owl:sameAs rdf:resource="http://yago-knowledge.org/resource/Deimos-1"/>
        <owl:sameAs rdf:resource="http://www.wikidata.org/entity/Q4037149"/>
        <rdfs:seeAlso rdf:resource="https://earth.esa.int/web/guest/missions/3rd-party-missions/current-missions/geosat-1"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://earth.esa.int/concept/55f485ec-f6d6-5154-9335-f9e9d8ee0324">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Clouds</skos:prefLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/162e2243-3266-4999-b352-d8a1a9dc82ac"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/earth-topics"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/0d2133c5-b0bb-5ce2-b000-243ade6a65b8"/>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-30</dct:modified>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Suspensions of minute water droplets or ice crystals produced by the condensation of water vapour.</skos:definition>
        <skos:related rdf:resource="https://earth.esa.int/concept/66ab957a-0434-5953-8b33-be95150a9ecb"/>
        <skos:closeMatch rdf:resource="https://www.eionet.europa.eu/gemet/en/concept/1491"/>
    </rdf:Description>
