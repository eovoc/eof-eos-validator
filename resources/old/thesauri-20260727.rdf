    <rdf:Description rdf:about="https://earth.esa.int/concept/5d1512a5-cb97-5e74-8778-35cd65c06936">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">POSEIDON-4</skos:prefLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/2092a1b6-776d-45eb-990a-2838a69c5d86"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/instruments"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/9a043c1c-b79e-56ea-8d29-ce17037667ef"/>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-11</dct:modified>
        <rdfs:seeAlso rdf:resource="https://www.eoportal.org/satellite-missions/copernicus-sentinel-6-michael-freilich"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Poseidon-4 is the primary payload of the Copernicus Sentinel-6 mission. This nadir-pointing dual-frequency SAR altimeter is designed to provide high accuracy and high precision altimetry measurements, including Sea Surface Height (SSH) from the radar range measurement, Significant Wave Height (Hs) and wind speed derived from normalised radar cross section.</skos:definition>
        <skos:altLabel xml:lang="en">Poseidon-4 Radar Altimeter</skos:altLabel>
        <sosa:isHostedBy rdf:resource="https://earth.esa.int/concept/2f8e271e-ccca-5a51-b185-28dafd6a81c4"/>
    </rdf:Description>
