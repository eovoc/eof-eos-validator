    <rdf:Description rdf:about="https://earth.esa.int/concept/f41bb355-30e5-530a-bd31-ac1145de72d6">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Thermosphere</skos:prefLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/0dc6a186-8da6-4a88-bb6b-3cc3343d2599"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/earth-topics"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/0d2133c5-b0bb-5ce2-b000-243ade6a65b8"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Refers to structure, composition, and dynamics of the thermosphere. The thermosphere is the upper part of Earth's atmosphere (altitudes ca. 100-1000km). Its density and composition are subject to gravitational separation. Its density and dynamics are driven by solar energetic radiation and waves propagating from lower atmospheric layers. The thermosphere exerts drag on objects orbiting within it.</skos:definition>
    </rdf:Description>
