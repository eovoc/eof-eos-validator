    <rdf:Description rdf:about="https://earth.esa.int/concept/675ee431-a60d-5f4f-adc8-37a123afcf11">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">MGM</skos:prefLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/ecb3b826-7409-4b0b-be34-51bfd8cd9ab5"/>
