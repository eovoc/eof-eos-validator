    <rdf:Description rdf:about="https://earth.esa.int/concept/88609a68-9dbf-567f-b1b1-321d4345b2da">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">WorldView-1</rdfs:label>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">WorldView-1</skos:prefLabel>
        <skos:altLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">WORLDVIEW-1</skos:altLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/7f13b4d2-9114-4890-ac6d-30da1a333d74"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/platforms"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/5c5e0c75-f931-553c-b44b-aceced616d25"/>
        <owl:sameAs rdf:resource="http://yago-knowledge.org/resource/WorldView-1"/>
        <owl:sameAs rdf:resource="http://dbpedia.org/resource/WorldView-1"/>
        <skos:notation xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">WV1</skos:notation>
        <skos:note xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">1</skos:note>
        <schema:event rdf:resource="https://earth.esa.int/event/launch/e7ae7066-93c5-5950-8796-81ec5728843c"/>
        <sosa:hosts rdf:resource="https://earth.esa.int/concept/284eecf9-5177-5106-b324-67b121e4e231"/>
        <rdfs:seeAlso rdf:resource="https://earth.esa.int/eogateway/search?text=worldview-1"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">The WorldView-1 satellite was launched on 18 September 2007 and became the world's first 50 cm resolution commercial imaging satellite.

	WorldView-1 circles the earth in a 496 km, 98 degree sun-synchronous orbit, which provides consistent 2 day revisit to areas of interest at mid-latitudes.</skos:definition>
    </rdf:Description>
