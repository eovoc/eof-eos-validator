    <rdf:Description rdf:about="https://earth.esa.int/concept/231f3607-59c0-5318-a639-9fa667d04cd9">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">HRG</skos:prefLabel>
        <skos:altLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">HRG-1</skos:altLabel>
