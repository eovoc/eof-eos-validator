        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/instruments"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/9e1f732e-98eb-5fc3-a798-453094cfe4c5"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://earth.esa.int/event/launch/5ef2f26f-3aea-5454-89b8-383b46bd58c5">
