    <rdf:Description rdf:about="https://earth.esa.int/concept/3bb38264-a964-5f24-8bac-12150da1d454">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">RBV</skos:prefLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/19b1f097-50a4-4a8b-9a2e-8b02fdc80855"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/instruments"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/764a170a-e361-5ea8-838e-e56994de69b7"/>
        <sosa:isHostedBy rdf:resource="https://earth.esa.int/concept/3078b489-b049-5328-ad71-f3da264d7c2f"/>
        <sosa:isHostedBy rdf:resource="https://earth.esa.int/concept/d0920f88-c8d6-53c9-80dd-0e9226e84a71"/>
        <sosa:isHostedBy rdf:resource="https://earth.esa.int/concept/de252973-e8f9-5b86-9957-1323f16c1e83"/>
        <rdfs:seeAlso rdf:resource="https://earth.esa.int/eogateway/instruments/return-beam-vidicon-rbv-/description"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">The RBV sensor utilized vidicon tube instruments containing an electron gun that read images from a photoconductive faceplate similar to television cameras. The data stream received from the satellite was analog-to-digital preprocessed to correct for radiometric and geometric errors.</skos:definition>
    </rdf:Description>
