    <rdf:Description rdf:about="https://earth.esa.int/concept/2659e931-c15f-5b28-82e4-36c69ee2f848">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">AMI/Scatterometer</skos:prefLabel>
        <skos:altLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">ERS WIND SCATTEROMETER</skos:altLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/d1c4be34-1053-42c5-bc81-bfdcb6b27567"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/instruments"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/901be9a7-1d68-5b6e-ad0a-5a1bf17623b8"/>
        <sosa:isHostedBy rdf:resource="https://earth.esa.int/concept/41660a0e-b024-5f96-bac7-03d20444800b"/>
        <sosa:isHostedBy rdf:resource="https://earth.esa.int/concept/ccf4c4fa-e698-5c16-a074-f958ccabce5e"/>
        <rdfs:seeAlso rdf:resource="https://earth.esa.int/web/guest/missions/esa-operational-eo-missions/ers/instruments/ws"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">The purpose of the Wind Scatterometer is to obtain information on wind speed and direction at the sea surface for incorporation into models, global statistics and climatological datasets. It operates by recording the change in radar reflectivity of the sea due to the perturbation of small ripples by the wind close to the surface. This is possible because the radar backscatter returned to the satellite is modified by wind-driven ripples on the ocean surface and, since the energy in these ripples increases with wind velocity, backscatter increases with wind velocity.</skos:definition>
    </rdf:Description>
