    <rdf:Description rdf:about="https://earth.esa.int/concept/cd5b16b7-4306-5a9d-9b37-9876d82bee1c">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Forest Management</skos:prefLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/d2056285-8249-4c11-810b-783600030525"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/earth-topics"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/80694ace-7a2a-50b0-9c22-4a4b45c985a1"/>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-30</dct:modified>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Planning of forest utilization for wood production, conservation purposes, fauna and flora protection, recreation and water supply.</skos:definition>
        <skos:closeMatch rdf:resource="https://www.eionet.europa.eu/gemet/en/concept/3425"/>
    </rdf:Description>
