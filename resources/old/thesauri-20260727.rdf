    <rdf:Description rdf:about="https://earth.esa.int/concepts/groups/mission-opportunities">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">MO (Mission Opportunity)</skos:prefLabel>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/platforms"/>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-07-12</dct:modified>
        <rdfs:seeAlso rdf:resource="https://sci.esa.int/web/cosmic-vision/-/59977-missions-of-opportunity"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Missions of Opportunity provide an important element of flexibility, allowing ESA and the community to respond quickly to opportunities that arise to participate in missions from partner agencies.
	The spirit of a Mission of Opportunity is to provide a tool through which the Programme can implement a relatively small, non-enabling participation in a partner-led mission, in exchange for a clear opportunity for the broad space science community in Europe to access scientific opportunities (for example, access to data or participation in mission science teams) that would otherwise not be available to them.</skos:definition>
        <skos:member rdf:resource="https://earth.esa.int/concept/d48f4b35-452f-5fe1-9b46-853b6194111d"/>
    </rdf:Description>
