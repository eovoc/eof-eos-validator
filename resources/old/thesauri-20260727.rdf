        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/platforms"/>
        <rdfs:seeAlso rdf:resource="https://www.esa.int/Applications/Observing_the_Earth/Copernicus/Introducing_Copernicus"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Copernicus is the Earth observation component of the European Union’s Space programme. It provides accurate, timely and easily accessible information to improve the management of the environment, understand and mitigate the effects of climate change and ensure civil security. ESA has developed a new family of satellites, called Sentinels, specifically for the operational needs of Copernicus.</skos:definition>
        <skos:member rdf:resource="https://earth.esa.int/concept/bd427795-f2f1-523e-a8eb-536af321363e"/>
        <skos:member rdf:resource="https://earth.esa.int/concept/e24f70f8-edcc-5289-999a-95100710652a"/>
