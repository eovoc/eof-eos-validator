    <rdf:Description rdf:about="https://earth.esa.int/concept/4bd77234-eabd-5691-8e0e-92a3f5305ae1">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">SCIAMACHY</skos:prefLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/782ba9cb-0707-4680-a446-9b7f0ff6477d"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/instruments"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/e586a38a-3b98-587d-97c8-85d70ff52d33"/>
        <owl:sameAs rdf:resource="http://yago-knowledge.org/resource/SCIAMACHY"/>
        <owl:sameAs rdf:resource="http://dbpedia.org/resource/SCIAMACHY"/>
        <owl:sameAs rdf:resource="http://www.wikidata.org/entity/Q2205341"/>
        <sosa:isHostedBy rdf:resource="https://earth.esa.int/concept/11ea961b-1d0b-5d6d-a55a-b58aed01d430"/>
        <rdfs:seeAlso rdf:resource="https://earth.esa.int/web/guest/missions/esa-operational-eo-missions/envisat/instruments/sciamachy"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">SCIAMACHY is an imaging spectrometer whose primary mission objective is to perform global measurements of trace gases in the troposphere and in the stratosphere. The solar radiation transmitted, backscattered and reflected from the atmosphere is recorded at relatively high resolution (0.2 nm to 0.5 nm) over the range 240 nm to 1700 nm, and in selected regions between 2000 nm and 2400 nm. The high resolution and the wide wavelength range make it possible to detect many different trace gases despite low concentrations (The mixing ratios of most constituents are of the order of 10-6 or less).</skos:definition>
    </rdf:Description>
