    <rdf:Description rdf:about="https://earth.esa.int/concept/a58b108b-492f-54a5-b807-cb97306b6aad">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">GOME</skos:prefLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/a0b0fd02-9952-4110-bac9-940a1b6e996f"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/instruments"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/e586a38a-3b98-587d-97c8-85d70ff52d33"/>
        <sosa:isHostedBy rdf:resource="https://earth.esa.int/concept/ccf4c4fa-e698-5c16-a074-f958ccabce5e"/>
        <rdfs:seeAlso rdf:resource="https://earth.esa.int/web/guest/missions/esa-operational-eo-missions/ers/instruments/gome"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">GOME is a nadir-scanning ultraviolet and visible spectrometer for global monitoring of atmospheric Ozone, launched on-board ERS-2 in April 1995. Since summer 1996, ESA has been delivering to users three-day GOME global observations of total ozone, nitrogen dioxide and related cloud information. A key feature of GOME was its ability to detect other chemically active atmospheric trace-gases as well as aerosol distribution.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://earth.esa.int/concept/988355eb-a637-53f2-beb3-20379a7653e4">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Soils</skos:prefLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/199e3af8-4cf3-48ba-8b28-b9b54756b3db"/>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/3526afb8-0dc9-43c7-8ad4-f34f250a1e91"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/earth-topics"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/e4d01e03-0ef5-5b4c-b40f-2b5f49667f53"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/bbe13d71-bea9-55c2-9b65-a24043c35937"/>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-30</dct:modified>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">The top layer of the land surface of the earth that is composed of disintegrated rock particles, humus, water and air.</skos:definition>
