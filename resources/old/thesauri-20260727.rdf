    <rdf:Description rdf:about="https://earth.esa.int/concept/b978b941-011f-55fa-abd5-14395b7b594b">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">EFI</skos:prefLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/5e95a04f-e746-4b55-b0f0-76631bb197fe"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/instruments"/>
