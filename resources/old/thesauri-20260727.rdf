    <rdf:Description rdf:about="https://earth.esa.int/concept/93343b90-3e9f-5830-abe7-151cc69401c1">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">ATSR-1</skos:prefLabel>
        <skos:altLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">ATSR</skos:altLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/39ac1813-238f-4fa3-b0cb-fe08a7dcadc4"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/instruments"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/66ab957a-0434-5953-8b33-be95150a9ecb"/>
        <sosa:isHostedBy rdf:resource="https://earth.esa.int/concept/41660a0e-b024-5f96-bac7-03d20444800b"/>
        <rdfs:seeAlso rdf:resource="https://earth.esa.int/web/guest/missions/esa-operational-eo-missions/ers/instruments/atsr"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">ATSR consists of two instruments, an Infra-Red Radiometer (IRR) and a Microwave Sounder (MWS). On board ERS-1 the IRR is a four-channel infra-red radiometer used for measuring sea-surface temperatures (SST) and cloud-top temperatures, whereas on board ERS-2 the IRR is equipped with additional visible channels for vegetation monitoring. The MWS is a two channel passive radiometer.</skos:definition>
    </rdf:Description>
