    <rdf:Description rdf:about="https://earth.esa.int/concept/d61ab7fc-fb41-5cec-87b8-79fcc3d6924c">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">IRM</skos:prefLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/a96885e0-9dc1-4edb-bc29-1cdb320d50f2"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/instruments"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/e586a38a-3b98-587d-97c8-85d70ff52d33"/>
        <sosa:isHostedBy rdf:resource="https://earth.esa.int/concept/a7adccea-4a39-5ebf-afd3-9608cd100f74"/>
        <rdfs:seeAlso rdf:resource="https://directory.eoportal.org/web/eoportal/satellite-missions/c-missions/cassiope"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">The IRM (Imaging and Rapid-scanning Ion Mass Spectrometer) objective is to observe the mass composition and 3-D velocity distributions (energy and angular) of ions in the energy range of 0.1-100 eV and 1-40 amu/q.</skos:definition>
    </rdf:Description>
