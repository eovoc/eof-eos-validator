        <skos:broader rdf:resource="https://earth.esa.int/concept/e586a38a-3b98-587d-97c8-85d70ff52d33"/>
        <sosa:isHostedBy rdf:resource="https://earth.esa.int/concept/dabc9eeb-fe74-5e6a-8ef8-c8ec2ca0468f"/>
    </rdf:Description>
