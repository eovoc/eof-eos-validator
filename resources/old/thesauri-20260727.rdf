        <skos:notation xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">SAO1A, SAO1B</skos:notation>
        <skos:note xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">1A, 1B</skos:note>
