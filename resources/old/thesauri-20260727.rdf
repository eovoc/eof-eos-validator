        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">The S1-4 Imager is a 4-band multispectral (+PAN) VHR optical sensor.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://earth.esa.int/concept/fde5528c-ff3e-5aa1-8c98-eae6be5fdb85">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">CER</skos:prefLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/1c03710e-1898-49ec-84bb-c064e7a358d0"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/instruments"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/b65c4835-3a76-528b-b0c8-6f621d9d19ac"/>
        <sosa:isHostedBy rdf:resource="https://earth.esa.int/concept/a7adccea-4a39-5ebf-afd3-9608cd100f74"/>
        <rdfs:seeAlso rdf:resource="https://directory.eoportal.org/web/eoportal/satellite-missions/c-missions/cassiope"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">the CER (Coherent Electromagnetic Radiation) objective is to determine ionospheric total electron density (TEC) by using a three-frequency beacon; cooperative ionospheric observations with fixed ground receivers.</skos:definition>
    </rdf:Description>
