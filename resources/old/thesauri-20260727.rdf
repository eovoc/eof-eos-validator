    <rdf:Description rdf:about="https://earth.esa.int/concept/27547a00-7d37-5113-b10f-666ccbfd86d4">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">RA</skos:prefLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/9873d448-7c5c-4d0b-b699-8683aa37dd4c"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/instruments"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/9a043c1c-b79e-56ea-8d29-ce17037667ef"/>
        <sosa:isHostedBy rdf:resource="https://earth.esa.int/concept/41660a0e-b024-5f96-bac7-03d20444800b"/>
        <sosa:isHostedBy rdf:resource="https://earth.esa.int/concept/ccf4c4fa-e698-5c16-a074-f958ccabce5e"/>
        <rdfs:seeAlso rdf:resource="https://earth.esa.int/web/guest/missions/esa-operational-eo-missions/ers/instruments/ra"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">The Radar Altimeter is a Ku-band (13.8 GHz) nadir-pointing active microwave sensor designed to measure the time return echoes from ocean and ice surfaces. Functioning in one of two operational modes (ocean or ice) the Radar Altimeter provides information on significant wave height; surface wind speed; sea surface elevation, which relates to ocean currents, the surface geoid and tides; and various parameters over sea ice and ice sheets.</skos:definition>
    </rdf:Description>
