        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-06-18</dct:modified>
        <rdfs:seeAlso rdf:resource="https://www.eoportal.org/satellite-missions/altius"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">The Atmospheric Limb Tracker for Investigation of the Upcoming Stratosphere (ALTIUS) mission will monitor the distribution and evolution of stratospheric ozone in the Earthâ&#128;&#153;s atmosphere.</skos:definition>
    </rdf:Description>
