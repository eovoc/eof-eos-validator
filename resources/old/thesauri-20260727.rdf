    <rdf:Description rdf:about="https://earth.esa.int/concept/dabc9eeb-fe74-5e6a-8ef8-c8ec2ca0468f">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">SCISAT-1</rdfs:label>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">SCISAT-1</skos:prefLabel>
        <skos:altLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">SCISAT-1/ACE</skos:altLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/5419ac51-33aa-4f66-bc37-9f2c73846c9e"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/platforms"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/c55d6941-023c-514c-a9c4-1693c053f861"/>
        <owl:sameAs rdf:resource="http://yago-knowledge.org/resource/SCISAT-1"/>
        <owl:sameAs rdf:resource="http://dbpedia.org/resource/SCISAT-1"/>
        <skos:notation xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">SC1</skos:notation>
        <skos:note xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">1</skos:note>
        <schema:event rdf:resource="https://earth.esa.int/event/launch/e69ac437-4e24-5703-9ad4-e4291a89a128"/>
        <sosa:hosts rdf:resource="https://earth.esa.int/concept/1a5c3d1d-4494-54cf-b549-88ffe104c59e"/>
        <sosa:hosts rdf:resource="https://earth.esa.int/concept/6baed7f4-7a76-58fc-965e-efc19debef05"/>
        <rdfs:seeAlso rdf:resource="https://earth.esa.int/web/guest/missions/3rd-party-missions/current-missions/scisat"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">SciSat-1/ACE is an atmospheric science mission of Canada. Through a 3rd party mission agreement ESA will make validated data from the ACE-FTS (ACE-Fourier Transform Spectrometer) available. The FTS measures the vertical distribution of trace gases, in particular of the regional polar O3 budget, as well as pressure and temperature (derived from CO2 lines).</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://earth.esa.int/concept/8757a0e0-df1f-5048-814c-791e28ca99a9">
