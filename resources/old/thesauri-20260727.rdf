    <rdf:Description rdf:about="https://earth.esa.int/concept/5000a03f-3f6e-51a6-8d48-a232d16e15e6">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">DMC constellation</rdfs:label>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">DMC</skos:prefLabel>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/platforms"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/c55d6941-023c-514c-a9c4-1693c053f861"/>
        <skos:notation xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">DM1,DM2</skos:notation>
        <skos:note xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">1.2</skos:note>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">The Disaster Monitoring Constellation (DMC) is an international program initially proposed in 1996 and led by SSTL (Surrey Satellite Technology Ltd), Surrey, UK, to construct a network of five affordable Low Earth Orbit (LEO) microsatellites. The objective is to provide a daily global imaging capability at medium resolution (30-40 m), in 3-4 spectral bands, for rapid-response disaster monitoring and mitigation.</skos:definition>
    </rdf:Description>
