    <rdf:Description rdf:about="https://earth.esa.int/concept/d1a82f20-68a9-5609-b261-123602bef1b0">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">GOSAT-1</rdfs:label>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">GOSAT-1</skos:prefLabel>
        <skos:altLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">GOSAT</skos:altLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/a21322af-38e0-4386-8e9b-9bf25cf30e16"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/platforms"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/c55d6941-023c-514c-a9c4-1693c053f861"/>
        <skos:notation xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">GS1</skos:notation>
        <skos:note xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">1</skos:note>
        <schema:event rdf:resource="https://earth.esa.int/event/launch/6affa24e-9fc3-5675-851f-9675cc37aa7f"/>
        <sosa:hosts rdf:resource="https://earth.esa.int/concept/4311d48c-b058-59bc-9b44-e6d3e6e38da1"/>
        <sosa:hosts rdf:resource="https://earth.esa.int/concept/7e5169b4-9d49-555f-9c69-5be21c8e5322"/>
        <rdfs:seeAlso rdf:resource="https://earth.esa.int/web/guest/missions/3rd-party-missions/current-missions/gosat"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">GOSAT (Greenhouse gases Observing Satellite) is a JAXA (Japan Aerospace Exploration Agency) mission within the GCOM (Global Change Observation Mission) program of Japan. The GOSAT mission goals call for the study of the transport mechanisms of greenhouse gases such as carbon dioxide (CO2) and methane (CH4).</skos:definition>
    </rdf:Description>
