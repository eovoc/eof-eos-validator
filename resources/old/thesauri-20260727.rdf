    <rdf:Description rdf:about="https://earth.esa.int/concepts/concept_scheme/platforms">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <rdfs:label xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Platforms</rdfs:label>
        <dct:modified xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2024-07-12</dct:modified>
        <dct:description xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">The current thesaurus contains the concepts related the following schemes: platforms, instruments and earth topics.</dct:description>
        <owl:versionInfo xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">1.13</owl:versionInfo>
        <dct:rights xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Copyright 2018-2024 European Space Agency.</dct:rights>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2021/04/20 - Update gcmd base URI from https://gcmdservices.gsfc.nasa.gov/ to https://gcmd.earthdata.nasa.gov/</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2018/10/10 - Sentinel-5P skos:notation added. Skos:definition for Sentinel missions added.</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2018/10/16 - Proba-V entry corrected.</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2019/03/01 - Entries GCOM-W1 and TRMM added,</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2019/03/05 - Entries biros, firebird tet-1 added</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2019/03/11 - Add entries alos-2, dmsp and narrowers, gpm, joint-polar-satellite-system-jpss, megha-tropiques</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2019/05/13 - Update for JCCB-CP-494</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2019/11/15 - updated due to JCCB-CP-506. IRS-P5, IRS-P6, IRS-R2, ResourceSat-2, Proba-V, Proba-1, Pleiades, BilSat-1, CryoSat(-2), PlanetScope, DMC, UK-DMC, UK-DMC-1, DM2 updated.</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2019/12/23 - updated for CEOS: add ISS for DLR, add missions for ECV, CCI. Move root one level up to include other missions than Earth Observation: Solar/Space Observation Satellites, Space stations/Manned Craft</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2020/03/03 - add platforms new JAXA collections: GCOM-C1</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2020/09/23 - Add GOSAT-2, GHGSat, GHGSat-D, GHGSat-C1, GHGSat-C2, JPSS-2, JPSS-3, JPSS-4,PAZ, WorldView4</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2020/09/23 - Add for CEOS: Earth Observation Satellite, Space Station/Manned Spacecraft, Solar/Space Observation Satellite, Earth Observing System, ISS, NASA Earth System Science Pathfinder, AEM,AEM-1, AEM-2, AEM-3</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2020/09/23 - Add for CEOS: CALIPSO, CFOSAT, CHAMP, CloudSat, CORIOLIS, FY-3A, FY-3B, GCOM, GCOM-C1, GMS, GMS-1..5, GOES, GOES-1..15</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2020/09/23 - Add for CEOS: Jason-2, MTSAT-1R, MTSAT-2, NOAA-20, Nimbus-4, SARAL, Sentinel-3A, Sentinel-3B, SMS, SMS-1, SMS-2, SORCE, TIROS, TIROS-N, TOPEX/POSEIDON, UARS</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2020/11/17 - Add MTSAT broader concept of MSAT-1R, MTSAT-2.</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2021/06/28 - Add concepts FSSCat , GEO-KOMPSAT-2B , GRACE-FO , COSMO-SkyMed Second Generation , ADEOS-I , ADEOS-II</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2022/03/17 - Add concepts SAOCOM, SAOCOM-1A, SAOCOM-1B</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2022/03/17 - Add concepts for CEOS JAXA: CALET, SLATS</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2022/03/30 - Add concepts TanSat, Vision-1, Pleiades Neo</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2022/03/30 - Update Relationship Platform to GCMD Space-based Platforms due to KMS GCMD update.</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2022/07/11 - rename DEIMOS to GEOSAT</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2024/01/11 - Updated structure and addition of several platforms.</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2024/06/18 - Added CBERS, CBERS-1, CBERS-2, CBERS-2B, CBERS-3, CBERS-4, CBERS-4A, Amazonia-1, Landsat-9, EnMap, FORUM, HARMONY, ALTIUS platforms. Added partial mappings to DBPedia, Yago and WikiData. Removed skos:altLabel when identical to prefLabel. Created skos:Collections for HM, TPM, EE and Earth Watch missions.</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2025/01/08 - Added GOES-18, NOAA-21, HotSat, HotSat-1 missions.</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2020/10/07 - Rename "NOA" prefLabel to "NOAA POES"</skos:changeNote>
        <skos:hasTopConcept rdf:resource="https://earth.esa.int/concept/738c519f-48db-5344-bebc-030c16781c22"/>
    </rdf:Description>
