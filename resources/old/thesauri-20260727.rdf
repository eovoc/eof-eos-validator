        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/fe07a2e4-a6cd-401c-af3e-433bbc8c2c98"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/platforms"/>
