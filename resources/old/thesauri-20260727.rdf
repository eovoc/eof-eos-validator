    </rdf:Description>
    <rdf:Description rdf:about="https://earth.esa.int/concept/5456b194-6f6d-5529-8e95-e5c660b6d174">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">FAI</skos:prefLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/0c439fcf-b55c-430e-baee-ae047032df46"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/instruments"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/b65c4835-3a76-528b-b0c8-6f621d9d19ac"/>
        <sosa:isHostedBy rdf:resource="https://earth.esa.int/concept/a7adccea-4a39-5ebf-afd3-9608cd100f74"/>
        <rdfs:seeAlso rdf:resource="https://directory.eoportal.org/web/eoportal/satellite-missions/c-missions/cassiope"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">FAI (Fast Auroral Imager) images the auroral emission in the near infrared (NIR) and visible (VIS) spectral range.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://earth.esa.int/concept/1114045a-a542-58ea-889d-52de3c469fa6">
