    <rdf:Description rdf:about="https://earth.esa.int/concept/b687f88d-4407-5c43-8f6a-85a5ab84f0d4">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">CryoSat-2</rdfs:label>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">CryoSat-2</skos:prefLabel>
        <skos:altLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">CRYOSAT-2</skos:altLabel>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/platforms"/>
        <skos:notation xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">CR2</skos:notation>
        <skos:note xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2</skos:note>
        <schema:event rdf:resource="https://earth.esa.int/event/launch/b7c39b08-1333-58da-868f-78fb0bc242a7"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Europe&amp;apos;s first ice mission is an advanced radar altimeter specifically designed to monitor the most dynamic sections of Earth&amp;apos;s cryosphere. It borrows synthetic aperture radar and interferometry techniques from standard imaging radar missions to sharpen its accuracy over rugged ice sheet margins and sea ice in polar waters. CryoSat-2 measures &amp;apos;freeboard&amp;apos; - the difference in height between sea ice and adjacent water - as well as ice sheet altitude, tracking changes in ice thickness.</skos:definition>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/a915ab2f-46c5-493b-9f18-aeb3383ee72b"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/c55d6941-023c-514c-a9c4-1693c053f861"/>
        <sosa:hosts rdf:resource="https://earth.esa.int/concept/5999338f-e606-5126-88b2-b0b12ec2c5ae"/>
        <sosa:hosts rdf:resource="https://earth.esa.int/concept/51394ba1-8475-54b0-9c27-f1823c7ca38d"/>
