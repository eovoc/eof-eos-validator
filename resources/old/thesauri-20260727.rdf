        <skos:broader rdf:resource="https://earth.esa.int/concept/e586a38a-3b98-587d-97c8-85d70ff52d33"/>
        <sosa:isHostedBy rdf:resource="https://earth.esa.int/concept/a4dbb7cf-f9d9-58f5-ada7-1e4d95d2f13e"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">TANSO-FTS-2 (Thermal and Near-infrared Sensor for Carbon Observation-Fourier Transform Spectrometer-2)</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://earth.esa.int/concept/51394ba1-8475-54b0-9c27-f1823c7ca38d">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">LRR CryoSat</skos:prefLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/f341648c-ed05-4def-8ba6-f7baff3a6836"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/instruments"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/b092eeb4-5408-5499-99bd-7fabf92e1f8f"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">The Laser Retro-Reflector (LRR) is a passive optical device attached to the underside of CryoSat. LRR is used as an additional tool and backup for precise orbit determination with the aid of the international laser tracking network.</skos:definition>
        <sosa:isHostedBy rdf:resource="https://earth.esa.int/concept/b687f88d-4407-5c43-8f6a-85a5ab84f0d4"/>
    </rdf:Description>
