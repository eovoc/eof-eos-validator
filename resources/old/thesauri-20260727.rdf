        <owl:sameAs rdf:resource="http://dbpedia.org/resource/JERS-1"/>
        <owl:sameAs rdf:resource="http://www.wikidata.org/entity/Q11277227"/>
        <skos:notation xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">JE1</skos:notation>
        <skos:note xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">1</skos:note>
        <schema:event rdf:resource="https://earth.esa.int/event/disposal/b528fa41-fcac-5128-a62e-22a5396c1353"/>
        <schema:event rdf:resource="https://earth.esa.int/event/heritage/8a33b821-6f59-5e7b-94e3-13dc8113dbe0"/>
        <schema:event rdf:resource="https://earth.esa.int/event/launch/08457eab-025b-5ed9-b107-9cf667f15ddc"/>
        <sosa:hosts rdf:resource="https://earth.esa.int/concept/102651e0-25c8-5f48-af0a-1c10d11be181"/>
        <sosa:hosts rdf:resource="https://earth.esa.int/concept/c3d32287-87ee-5e88-89c7-21a3607be413"/>
        <rdfs:seeAlso rdf:resource="https://earth.esa.int/web/guest/missions/3rd-party-missions/historical-missions/jers-1"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">JERS-1, launched in Feb 1992 and ended in Oct 1998, was a joint Japanese radar/optical mission with NASDA/JAXA lead. The overall objectives were the generation of global data sets with SAR and OPS sensors aimed at surveying resources, establishing an integrated Earth observation system, verifying instrument/system performances.</skos:definition>
    </rdf:Description>
