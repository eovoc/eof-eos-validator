        <sosa:isHostedBy rdf:resource="https://earth.esa.int/concept/8757a0e0-df1f-5048-814c-791e28ca99a9"/>
        <sosa:isHostedBy rdf:resource="https://earth.esa.int/concept/d2f975f3-62aa-5124-b693-239dae7a58c9"/>
        <rdfs:seeAlso rdf:resource="https://earth.esa.int/web/guest/missions/esa-eo-missions/swarm/instruments/efi"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">The Electric Field Instrument determines the ion density, the ion drift velocity, and the electric field at the S/C front panel (in-flight). The instrument consists of two components: the Langmuir Probe (LP) and the Thermal Ion Imager (TII).</skos:definition>
    </rdf:Description>
