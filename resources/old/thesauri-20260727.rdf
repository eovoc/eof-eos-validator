        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">TANSO-FTS-2</skos:prefLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/da57ac0a-e5ab-47f4-996f-06c12e1a4a62"/>
