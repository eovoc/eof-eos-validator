        <skos:related rdf:resource="https://earth.esa.int/concept/901be9a7-1d68-5b6e-ad0a-5a1bf17623b8"/>
        <skos:closeMatch rdf:resource="https://www.eionet.europa.eu/gemet/en/concept/7843"/>
        <skos:closeMatch rdf:resource="https://www.eionet.europa.eu/gemet/en/inspire-theme/so"/>
