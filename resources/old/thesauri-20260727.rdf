        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/3b6b4870-ae80-4488-b9fb-f9152037ec59"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/platforms"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/c55d6941-023c-514c-a9c4-1693c053f861"/>
        <owl:sameAs rdf:resource="http://yago-knowledge.org/resource/European_Remote-Sensing_Satellite"/>
        <owl:sameAs rdf:resource="http://dbpedia.org/resource/European_Remote-Sensing_Satellite"/>
        <owl:sameAs rdf:resource="http://www.wikidata.org/entity/Q63347"/>
        <skos:notation xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">ER1,ER2</skos:notation>
        <skos:note xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">1.2</skos:note>
        <rdfs:seeAlso rdf:resource="https://earth.esa.int/web/guest/missions/esa-operational-eo-missions/ers"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">ESA's two European Remote Sensing (ERS) satellites, ERS-1 and ERS-2, were launched into the same orbit in 1991 and 1995 respectively. Their payloads included a synthetic aperture imaging radar, radar altimeter and instruments to measure ocean surface temperature and wind fields. ERS-2 added an additional sensor for atmospheric ozone monitoring. The two satellites acquired a combined data set extending over two decades.</skos:definition>
        <skos:narrower rdf:resource="https://earth.esa.int/concept/41660a0e-b024-5f96-bac7-03d20444800b"/>
        <skos:narrower rdf:resource="https://earth.esa.int/concept/ccf4c4fa-e698-5c16-a074-f958ccabce5e"/>
        <skos:altLabel xml:lang="en">European Remote Sensing Satellite (ERS)</skos:altLabel>
    </rdf:Description>
