    <rdf:Description rdf:about="https://earth.esa.int/concept/811133ca-c658-5bcf-b1de-3bee525ae3d8">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Sentinel-5 Precursor</rdfs:label>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Sentinel-5P</skos:prefLabel>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/platforms"/>
        <skos:notation xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">S5P</skos:notation>
        <schema:event rdf:resource="https://earth.esa.int/event/launch/f50ef628-f905-5205-981a-f0b82620fed3"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">A precursor satellite mission, Sentinel-5P aims to fill in the data gap and provide data continuity between the retirement of the Envisat satellite and NASA&amp;apos;s Aura mission and the launch of Sentinel-5. The mission will perform atmospheric monitoring and was launched in October 2017.</skos:definition>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/77e9a75e-2c3b-428b-8b21-b6a902dd8fee"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/c55d6941-023c-514c-a9c4-1693c053f861"/>
        <sosa:hosts rdf:resource="https://earth.esa.int/concept/12f0c6eb-19fc-5bcd-8902-c46941e8a23b"/>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-22</dct:modified>
        <owl:sameAs rdf:resource="http://dbpedia.org/resource/Sentinel-5_Precursor"/>
        <owl:sameAs rdf:resource="http://yago-knowledge.org/resource/Sentinel-5_Precursor"/>
        <rdfs:seeAlso rdf:resource="https://earth.esa.int/web/guest/missions/esa-eo-missions/sentinel-5p"/>
        <rdfs:seeAlso rdf:resource="https://directory.eoportal.org/web/eoportal/satellite-missions/c-missions/copernicus-sentinel-5p"/>
    </rdf:Description>
