    <rdf:Description rdf:about="https://earth.esa.int/concept/90c5a05d-6f00-5187-90b5-2963273124ed">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">MWR</skos:prefLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/24536b41-a968-4626-9516-7cf4c158334c"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/instruments"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/66ab957a-0434-5953-8b33-be95150a9ecb"/>
        <sosa:isHostedBy rdf:resource="https://earth.esa.int/concept/41660a0e-b024-5f96-bac7-03d20444800b"/>
        <sosa:isHostedBy rdf:resource="https://earth.esa.int/concept/ccf4c4fa-e698-5c16-a074-f958ccabce5e"/>
        <sosa:isHostedBy rdf:resource="https://earth.esa.int/concept/11ea961b-1d0b-5d6d-a55a-b58aed01d430"/>
        <rdfs:seeAlso xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">MWR</rdfs:seeAlso>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">The main objective of the microwave radiometer (MWR) is the measurement of the integrated atmospheric water vapour column and cloud liquid water content, as correction terms for the radar altimeter signal. In addition, MWR measurement data are useful for the determination of surface emissivity and soil moisture over land, for surface energy budget investigations to support atmospheric studies, and for ice characterization.</skos:definition>
    </rdf:Description>
