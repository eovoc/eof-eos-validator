        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/instruments"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/764a170a-e361-5ea8-838e-e56994de69b7"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">The panchromatic resolution is 2.5m / 5 m. Imagery at a resolution of 2.5 metres in the panchromatic band is obtained using a sampling concept unique to SPOT 5, called Supermode. This concept processes two 5-metre panchromatic images acquired simultaneously to generate a single image at a resolution of 2.5 metres.</skos:definition>
        <sosa:isHostedBy rdf:resource="https://earth.esa.int/concept/91d75764-3e85-53c7-8e4b-6b4d6d2ed8c9"/>
    </rdf:Description>
