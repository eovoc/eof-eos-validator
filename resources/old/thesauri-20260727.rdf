    <rdf:Description rdf:about="https://earth.esa.int/concept/155f604b-37cf-5d2d-8cf3-340f933c6ffc">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Chinese Carbon Dioxide Observation Satellite</rdfs:label>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">TanSat</skos:prefLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/3b26dec5-2cb1-48ce-9873-048c321fdebe"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/platforms"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/c55d6941-023c-514c-a9c4-1693c053f861"/>
        <owl:sameAs rdf:resource="http://yago-knowledge.org/resource/TanSat"/>
        <owl:sameAs rdf:resource="http://dbpedia.org/resource/TanSat"/>
        <skos:notation xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">TA</skos:notation>
        <schema:event rdf:resource="https://earth.esa.int/event/disposal/1d05765c-5d4c-5620-98df-8035c7119fe2"/>
        <schema:event rdf:resource="https://earth.esa.int/event/launch/5e75b882-8b40-5c31-ae81-30cedb47bd3b"/>
        <sosa:hosts rdf:resource="https://earth.esa.int/concept/672ff96e-d30b-54ab-9d41-4911a201e605"/>
        <sosa:hosts rdf:resource="https://earth.esa.int/concept/ae9e73fb-a94d-51a3-841f-921dd7cb4b30"/>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-03-30</dct:modified>
        <rdfs:seeAlso rdf:resource="https://eoportal.org/web/eoportal/satellite-missions/t/tansat"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">The first Chinese Carbon Dioxide Observation Satellite Mission (TanSat) was launched on December 21, 2016. It carries two instruments on-board: the Atmospheric Carbon-dioxide Grating Spectrometer (ACGS) and the multiple-band Cloud and Aerosol Polarization Imager (CAPI). TanSat flies in a sun-synchronous low Earth orbit (LEO) with an equator crossing time around 13:30 local time. The satellite operates in three measurement modes: nadir (ND), glint (GL) and target (TG). The swath width of TanSat measurements is ~18 km across the satellite track and contains 9 footprints each with a size of 2 km Ã&#151; 2 km in nadir. Nadir and glint mode alternate orbit-by-orbit, and the TanSat nadir model ground track is typically between two OCO-2 tracks, which provides potential future opportunities for combined usage of both data products for increased spatial coverage.</skos:definition>
    </rdf:Description>
