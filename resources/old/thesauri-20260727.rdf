    <rdf:Description rdf:about="https://earth.esa.int/concept/5152089a-f8a8-5311-8d89-67a28da2f45f">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">NMS</skos:prefLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/e0134cc6-79d0-492d-9e9a-6320e04ed972"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/instruments"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/5f5c5a52-3d9c-509b-86b7-a396a261d2b2"/>
        <sosa:isHostedBy rdf:resource="https://earth.esa.int/concept/a7adccea-4a39-5ebf-afd3-9608cd100f74"/>
        <rdfs:seeAlso rdf:resource="https://directory.eoportal.org/web/eoportal/satellite-missions/c-missions/cassiope"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">NMS (Neutral Mass and Velocity Spectrometer) measures the density and velocity of neutral atmospheric species using an open-source electron impact ionization chamber and a microchannel plate (MCP) imaging detection subassembly. It employs a planar entrance aperture with a plasma filter to repel low energy charged particles.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://earth.esa.int/concept/29210769-e87c-5450-be04-a999f187b9c4">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">SSTL S1-4</rdfs:label>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Vision-1</skos:prefLabel>
        <skos:altLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">SI-4</skos:altLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/337848d8-f442-4bd5-9a6a-c8374baef38c"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/platforms"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/c55d6941-023c-514c-a9c4-1693c053f861"/>
        <skos:notation xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">VI</skos:notation>
        <schema:event rdf:resource="https://earth.esa.int/event/launch/928c70de-1f16-5458-84b4-a173ea5cafee"/>
        <sosa:hosts rdf:resource="https://earth.esa.int/concept/d3c972d8-316b-5876-bca5-6dc39ab40101"/>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-03-30</dct:modified>
        <rdfs:seeAlso rdf:resource="https://earth.esa.int/eogateway/vision-1-overview?text=vision-1+overview"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Vision-1 provides complementary imaging capacity to the existing Airbus Earth Observation constellation, delivering orthorectified optical data with resolution up to 87cm as standard.</skos:definition>
    </rdf:Description>
