    <rdf:Description rdf:about="https://earth.esa.int/concept/67951438-5c24-5a4a-a2c9-8a5ef584078c">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">GHGSat-C1</rdfs:label>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">GHGSat-C</skos:prefLabel>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/platforms"/>
        <skos:notation xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">GC</skos:notation>
        <schema:event rdf:resource="https://earth.esa.int/event/launch/7911100c-805f-5f6d-a0ea-b65bd416302b"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">In order to expand satellite system capacity after the successful launch of its demonstration satellite, GHGSat started the design of two (2) additional high-resolution satellites in January 2017, called GHGSat-C1 (â&amp;#128;&amp;#156;Irisâ&amp;#128;&amp;#157;) and GHGSat-C2 (â&amp;#128;&amp;#156;Hugoâ&amp;#128;&amp;#157;), respectively. GHGSat-C1/-C2 are intended to have similar designs to GHGSat-D, while applying critical lessons learned to improve performance. See also https://www.ghgsat.com.</skos:definition>
        <sosa:hosts rdf:resource="https://earth.esa.int/concept/4c47c487-9ed5-5767-ade0-2487e15cb5df"/>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-17</dct:modified>
        <rdfs:seeAlso rdf:resource="https://earth.esa.int/web/sppa/activities/edap/atmospheric-missions/ghgsat-d"/>
        <rdfs:seeAlso rdf:resource="https://directory.eoportal.org/web/eoportal/satellite-missions/g/ghgsat-c1-c2"/>
        <schemaorg:event xmlns:schemaorg="https://schema.org/" rdf:resource="https://earth.esa.int/event/operation/466fb93e-e799-506d-9fd4-cedf7b8edd11"/>
        <sosa:hosts rdf:resource="https://earth.esa.int/concept/af5e7cff-4d10-5232-962b-a8a4c2f34c8e"/>
        <sosa:hosts rdf:resource="https://earth.esa.int/concept/4132bb36-b2c4-5afe-92b3-c750e6e1d257"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/4703b949-9788-5040-bbbd-a4c29009e858"/>
    </rdf:Description>
