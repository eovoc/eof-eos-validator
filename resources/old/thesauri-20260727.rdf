        <schemaorg:event xmlns:schemaorg="https://schema.org/" rdf:resource="https://earth.esa.int/event/operation/2c4f28ed-4f8e-5696-97c8-23603a4759de"/>
        <schemaorg:event xmlns:schemaorg="https://schema.org/" rdf:resource="https://earth.esa.int/event/disposal/84a5f768-6916-5d9b-b093-9517eb1e298d"/>
