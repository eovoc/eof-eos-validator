        <owl:sameAs rdf:resource="http://dbpedia.org/resource/Ikonos"/>
        <skos:notation xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">IK2</skos:notation>
        <skos:note xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2</skos:note>
        <schema:event rdf:resource="https://earth.esa.int/event/disposal/4ac8cf93-5222-5d19-ab61-5739044dda07"/>
        <schema:event rdf:resource="https://earth.esa.int/event/launch/f722e772-0e04-5ec4-be2b-5a96595cd447"/>
        <schema:event rdf:resource="https://earth.esa.int/event/heritage/d23445f8-ad7a-5346-8fd1-e496a9e8710c"/>
        <sosa:hosts rdf:resource="https://earth.esa.int/concept/786a3a53-792d-54f8-a598-847d60cadd45"/>
        <rdfs:seeAlso rdf:resource="https://earth.esa.int/web/guest/missions/3rd-party-missions/current-missions/ikonos-2"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">IKONOS was an imaging satellite of DigitalGlobe providing high-resolution imagery on a commercial basis. With IKONOS, a new era of 1m spatial resolution imagery began for spaceborne instruments in the field of civil Earth observation. The IKONOS satellite system was built by LMMS (Lockheed Martin Missiles &amp; Space) of Sunnyvale, CA (USA).</skos:definition>
    </rdf:Description>
