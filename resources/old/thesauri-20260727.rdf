        <sosa:isHostedBy rdf:resource="https://earth.esa.int/concept/1abfac39-23bf-561f-a765-76da42a79d44"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">MGM (3-axis Magnetometer) is used for magnetic torquer control and as rate sensors. The readings from the three MGM on each axis are subject to a 2 out of 3 majority voting scheme.</skos:definition>
    </rdf:Description>
