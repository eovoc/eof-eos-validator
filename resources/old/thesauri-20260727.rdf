    <rdf:Description rdf:about="https://earth.esa.int/concepts/concept_scheme/earth-topics">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <rdfs:label xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Earth Topics</rdfs:label>
        <dct:modified xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2024-05-30</dct:modified>
        <dct:title xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">ESA Thesaurus</dct:title>
        <dct:description xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">The current thesaurus contains the concepts related the following schemes: platforms, instruments and earth topics.</dct:description>
        <owl:versionInfo xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">1.9</owl:versionInfo>
        <dct:rights xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Copyright 2018-2024 European Space Agency.</dct:rights>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2021/04/20 - Update gcmd base URI from https://gcmdservices.gsfc.nasa.gov/ to https://gcmd.earthdata.nasa.gov/</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2018/08/07 - Original with Earth topics as used in Earth Online Web pages.</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2018/10/08 - rdfs:label added to concept scheme</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2019/05/13 - Update according to eo_sci_app_keywords_v11 (JCCB-CP-494).</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2019/11/15 - remove fields reporting names</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2020/09/23 - add instrument types derived from collections definitions.</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2021/04/20 - Add concept Core, Lithosphere, Thermosphere</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2021/04/20 - Update concept "Gravity and Gravitational" moved to altLabel, PrefLabel becomes Geodesy Gravity</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2021/04/20 - Update concept Mantle</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2021/04/29 - Rename Sun-Earth Interaction to Space weather</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2021/06/28 - Update related to CP-536: GCMD prefix URI, Core definition, new concepts for Gravity and Gravitational, Lithophere, Mantle, Space Weather, Thermosphere</skos:changeNote>
        <skos:changeNote xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">2024/05/30 - Update adding mappings to GEMET and INSPIRE thesauri.</skos:changeNote>
        <skos:hasTopConcept rdf:resource="https://earth.esa.int/concept/5c476560-e0a3-554a-9187-187a90da1309"/>
    </rdf:Description>
