    <rdf:Description rdf:about="https://earth.esa.int/concept/dd7e18bf-c8b9-5f00-acc7-a443c761e524">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">GPM</rdfs:label>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">GPM</skos:prefLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/33a893cb-b328-462e-9cb0-d8c27823239e"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/platforms"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/c55d6941-023c-514c-a9c4-1693c053f861"/>
        <owl:sameAs rdf:resource="http://dbpedia.org/resource/Global_Precipitation_Measurement"/>
        <owl:sameAs rdf:resource="http://www.wikidata.org/entity/Q3108963"/>
        <skos:notation xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">GPM</skos:notation>
        <schema:event rdf:resource="https://earth.esa.int/event/launch/f06ad837-f0bc-59fd-85c1-f3a9f14e2ac2"/>
        <sosa:hosts rdf:resource="https://earth.esa.int/concept/c17deee1-3983-5c72-8d25-43ca30c3a317"/>
        <sosa:hosts rdf:resource="https://earth.esa.int/concept/862fb0a9-137b-542d-b714-b531871b77fa"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">GPM Constellation is a joint mission with the Japan Aerospace Exploration Agency (JAXA) and other international partners. Building upon the success of the Tropical Rainfall Measuring Mission (TRMM), it will initiate the measurement of global precipitation, a key climate factor.</skos:definition>
    </rdf:Description>
