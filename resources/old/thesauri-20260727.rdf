    <rdf:Description rdf:about="https://earth.esa.int/concept/44446004-f93d-57a4-837d-a7776bb5a720">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">GeoEye-1</rdfs:label>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">GeoEye-1</skos:prefLabel>
        <skos:altLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">GEOEYE-1</skos:altLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/47943416-e045-4d6d-b18e-3d1cc51734e0"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/platforms"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/c55d6941-023c-514c-a9c4-1693c053f861"/>
        <owl:sameAs rdf:resource="http://yago-knowledge.org/resource/GeoEye-1"/>
        <owl:sameAs rdf:resource="http://dbpedia.org/resource/GeoEye-1"/>
        <owl:sameAs rdf:resource="http://www.wikidata.org/entity/Q428048"/>
        <skos:notation xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">GE1</skos:notation>
        <skos:note xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">1</skos:note>
        <schema:event rdf:resource="https://earth.esa.int/event/launch/3f5d372b-a831-5887-bb32-847b9c4fbbc5"/>
        <sosa:hosts rdf:resource="https://earth.esa.int/concept/1790ceeb-0878-50e7-84f9-98926ee3abda"/>
        <rdfs:seeAlso rdf:resource="https://earth.esa.int/web/guest/missions/3rd-party-missions/current-missions/geoeye-1"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">GeoEye-1, launched in September 2008, is an imaging satellite of DigitalGlobe Inc. of Longmont, CO, USA. The spacecraft is in a sun-synchronous orbit with an operating altitude of 681km. GeoEye-1 collects images at 0.41m panchromatic and 1.65m 4-bands multi-spectral data.</skos:definition>
    </rdf:Description>
