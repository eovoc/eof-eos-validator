    <rdf:Description rdf:about="https://earth.esa.int/concept/b6d01cb5-a690-4ec8-8940-4b4d2aee1a9b">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">GRACE</rdfs:label>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">GRACE</skos:prefLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/2e7aa2e6-9d25-4c6e-aef3-6e86d3773bac"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/platforms"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/c55d6941-023c-514c-a9c4-1693c053f861"/>
        <owl:sameAs rdf:resource="http://dbpedia.org/resource/GRACE_and_GRACE-FO"/>
        <owl:sameAs rdf:resource="http://www.wikidata.org/entity/Q704319"/>
        <skos:notation xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">GR</skos:notation>
        <rdfs:seeAlso rdf:resource="https://earth.esa.int/web/guest/missions/3rd-party-missions/current-missions/grace"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">The primary science objective of GRACE was to measure the Earth's gravity field and its time variability with unprecedented accuracy. The secondary science objective was to obtain approximately 150 very precise globally distributed vertical temperature and humidity profiles of the atmosphere per day using the GPS radio occultation technique.</skos:definition>
        <skos:narrower rdf:resource="https://earth.esa.int/concept/2e207578-6fac-58c4-9f0c-f67519ea14e0"/>
        <skos:narrower rdf:resource="https://earth.esa.int/concept/607d44f8-5d34-53f3-8171-5b4b7bee20a7"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://earth.esa.int/event/heritage/c102403f-d2dd-5c8b-8b81-93d9741888dd">
        <rdf:type rdf:resource="https://schema.org/Event"/>
