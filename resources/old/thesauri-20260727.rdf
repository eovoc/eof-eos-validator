        <owl:sameAs rdf:resource="http://yago-knowledge.org/resource/Cartosat-1"/>
        <owl:sameAs rdf:resource="http://dbpedia.org/resource/Cartosat-1"/>
        <owl:sameAs rdf:resource="http://www.wikidata.org/entity/Q2940667"/>
        <skos:notation xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">IP5</skos:notation>
        <skos:note xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">P5</skos:note>
        <schema:event rdf:resource="https://earth.esa.int/event/disposal/1cbd58f0-d788-5035-a74a-5d484aa8fbbc"/>
        <schema:event rdf:resource="https://earth.esa.int/event/launch/af9075d4-16c9-5e87-a894-787202c479c6"/>
        <sosa:hosts rdf:resource="https://earth.esa.int/concept/b785bd76-6a28-55bd-99eb-aeb3ef7aefbb"/>
        <rdfs:seeAlso rdf:resource="https://earth.esa.int/web/guest/missions/3rd-party-missions/current-missions/cartosat-1"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">The Indian Remote Sensing Satellite CartoSat-1 (also known as IRS-P5) was successfully launched into polar orbit on 5 May 2005. The payload was lifted by the PSLV-C6 and for the first time the new Second Launch Pad at Satish Dhawan Space Centre was used. The satellite has two panchromatic cameras that were especially designed for in flight stereo viewing.</skos:definition>
    </rdf:Description>
