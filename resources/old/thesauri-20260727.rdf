    <rdf:Description rdf:about="https://earth.esa.int/concept/87ab11ce-a093-58f9-8372-0637f059b5cc">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Cultural Heritage</skos:prefLabel>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/earth-topics"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/2a1c3522-f4a0-5d63-9d47-7af06a220302"/>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-30</dct:modified>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">The inherited body of beliefs, customs, artistic activity and knowledge that has been transmitted by ancestors.</skos:definition>
        <skos:related rdf:resource="https://earth.esa.int/concept/8f86e1ce-97c3-534d-b370-2692352992fe"/>
