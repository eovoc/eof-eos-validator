    <rdf:Description rdf:about="https://earth.esa.int/concept/192ce5dc-2e35-5393-a1c5-f275f0028f6e">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Atmospheric Limb Tracker for the Investigation of the Upcoming Stratosphere</rdfs:label>
