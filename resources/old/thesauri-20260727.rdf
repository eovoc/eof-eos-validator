        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/cf6b8783-02c7-4aae-9c46-08468a6c61c8"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/instruments"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/764a170a-e361-5ea8-838e-e56994de69b7"/>
        <sosa:isHostedBy rdf:resource="https://earth.esa.int/concept/fb88429a-c85c-5fc3-9c81-d47117b1ac55"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">SCA is of GRACE-1 and CHAMP heritage, and its objective is the precise measurement of GRACE-FO satellite attitude. SCA consists of two DTU (Technical University of Denmark) star camera assemblies (2 cameras with sensor heads), each with a FOV of 18Âº x 16Âº and one DPU (Data Processing Unit).</skos:definition>
        <sosa:isHostedBy rdf:resource="https://earth.esa.int/concept/2e0bbb68-bae9-5d13-873f-94cb556f2ddb"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://earth.esa.int/concept/5bbf099f-cc80-5326-972c-a372028e0eba">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Spectroradiometers</skos:prefLabel>
