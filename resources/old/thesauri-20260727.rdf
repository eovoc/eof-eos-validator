        <rdfs:label xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">IRS-P5</rdfs:label>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">IRS-P5</skos:prefLabel>
        <skos:altLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Cartosat-1</skos:altLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/1d98408e-7465-4d31-86fa-3835a137b78d"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/platforms"/>
