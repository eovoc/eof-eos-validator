    <rdf:Description rdf:about="https://earth.esa.int/concept/72aad1c4-ff46-535c-9256-cc0bf9d004f1">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">AMI/SAR</skos:prefLabel>
        <skos:altLabel xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">AMI</skos:altLabel>
        <skos:exactMatch rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/c6c1ba5b-650d-48f9-b101-2a3842da834d"/>
        <skos:inScheme rdf:resource="https://earth.esa.int/concepts/concept_scheme/instruments"/>
        <skos:broader rdf:resource="https://earth.esa.int/concept/8f86e1ce-97c3-534d-b370-2692352992fe"/>
        <sosa:isHostedBy rdf:resource="https://earth.esa.int/concept/41660a0e-b024-5f96-bac7-03d20444800b"/>
        <sosa:isHostedBy rdf:resource="https://earth.esa.int/concept/ccf4c4fa-e698-5c16-a074-f958ccabce5e"/>
        <rdfs:seeAlso rdf:resource="https://earth.esa.int/web/guest/missions/esa-operational-eo-missions/ers/instruments/sar"/>
        <skos:definition xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">SAR wave mode provides two-dimensional spectra of ocean surface waves. For this function the SAR records regularly spaced samples within the image swath. The images are transformed into directional spectra providing information about wavelength and direction of wave systems. Automatic measurements of dominant wavelengths and directions will improve sea forecast models, but the imagettes can also show the effects of other phenomena, such as internal waves, slicks, small scale variations in wind and modulations due to surface currents and the presence of sea ice.</skos:definition>
    </rdf:Description>
