<rdf:Description rdf:about="https://earth.esa.int/concepts/concept_scheme/productclass">
	<dct:title xml:lang="en">Product Classes</dct:title>
	<rdfs:label>Product Classes</rdfs:label>
	<dct:description>Product Class allows to specify the usage of the file, for a specific phase of the ground segment development or operations cycle. It allows, in particular, to reset version counters for each new phase without any risk of having ambiguous product names</dct:description>
	<rdfs:seeAlso rdf:resource="https://eof-eos.io.esa.int/eopf-eos/data-model/8-naming-convention.html#product-clas"/>
	<dct:rights>Copyright 2026 European Space Agency.</dct:rights>
	<skos:changeNote>2026/06/04 - Initial version</skos:changeNote>
</rdf:Description>

