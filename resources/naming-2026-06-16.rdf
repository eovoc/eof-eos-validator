<rdf:Description rdf:about="https://earth.esa.int/concepts/concept_scheme/filenameshape">
	<dct:title xml:lang="en">Filename Shapes</dct:title>
	<rdfs:label>Filename Shapes</rdfs:label>
	<rdfs:seeAlso rdf:resource="https://eof-eos.io.esa.int/eopf-eos/data-model/8-naming-convention.html#instance-id"/>
	<dct:description>Product Class allows to specify the usage of the file, for a specific phase of the ground segment development or operations cycle. It allows, in particular, to reset version counters for each new phase without any risk of having ambiguous product names</dct:description>
	<dct:rights>Copyright 2026 European Space Agency.</dct:rights>
	<skos:changeNote>2026/06/04 - Sinitial version</skos:changeNote>
</rdf:Description>

